<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════
             HERO SECTION — dark gradient with animated bus
             ═══════════════════════════════════════ -->

        <RelativeLayout
            android:id="@+id/heroSection"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@drawable/bg_hero_gradient"
            android:clipToPadding="false">

            <!-- Decorative dot pattern (top-right) -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:alpha="0.06"
                android:background="@drawable/bg_card_dark" />

            <!-- Route track line (the bus drives on this) -->
            <View
                android:id="@+id/routeTrackLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:alpha="0.25"
                android:background="#FFFFFF" />

            <!-- Stop dot — start -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="44dp"
                android:background="@drawable/bg_route_dot" />

            <!-- Stop dot — campus (end) -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="22dp"
                android:layout_marginBottom="44dp"
                android:background="@drawable/bg_route_dot" />

            <!-- Stop dot — mid 1 -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="45dp"
                android:layout_marginStart="110dp"
                android:alpha="0.6"
                android:background="@drawable/bg_route_dot" />

            <!-- Stop dot — mid 2 -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="45dp"
                android:layout_marginStart="210dp"
                android:alpha="0.6"
                android:background="@drawable/bg_route_dot" />

            <!-- Animated Bus Icon -->

            <!-- Campus flag (destination marker) -->
            <ImageView
                android:id="@+id/imgAnimatedBus"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="30dp"
                android:contentDescription="College bus"
                android:scaleType="fitXY"
                android:src="@drawable/ic_bus" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="26dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓"
                    android:textSize="18sp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="14dp"
                    android:alpha="0.5"
                    android:background="#FFFFFF" />

            </LinearLayout>

            <!-- App title & subtitle -->
            <LinearLayout
                android:id="@+id/heroTitleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:alpha="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="College Transport"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRACKER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#818CF8"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safe rides. Brighter tomorrows."
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </RelativeLayout>


        <!-- ═══════════════════════════════════════
             QUICK ACCESS GRID
             ═══════════════════════════════════════ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACCESS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorIndigo"
                android:letterSpacing="0.12"
                android:layout_marginBottom="14dp" />

            <!-- Row 1: Bus Details + Routes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- BUS DETAILS CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBusDetails"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1E293B"
                    android:alpha="0">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp">

                        <!-- Accent corner blob -->
                        <View
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="-10dp"
                            android:layout_marginEnd="-10dp"
                            android:alpha="0.15"
                            android:background="@drawable/bg_badge_indigo" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <!-- Icon pill -->
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:text="🚌"
                                android:textSize="22sp"
                                android:gravity="center"
                                android:background="@drawable/bg_badge_indigo"
                                android:alpha="0.9" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bus Details"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fleet overview"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="3dp" />

                            <!-- Spacer -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/btnBusDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="View →"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#818CF8"
                                android:background="@null"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <!-- ROUTES CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRoutes"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#132D1F"
                    android:alpha="0">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp">

                        <View
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="-10dp"
                            android:layout_marginEnd="-10dp"
                            android:alpha="0.15"
                            android:background="@drawable/bg_badge_emerald" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:text="📍"
                                android:textSize="22sp"
                                android:gravity="center"
                                android:background="@drawable/bg_badge_emerald"
                                android:alpha="0.85" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bus Routes"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stops &amp; paths"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="3dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/btnRoutes"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="View →"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#34D399"
                                android:background="@null"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- Row 2: Schedule + Drivers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <!-- SCHEDULE CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSchedule"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#2A1F08"
                    android:alpha="0">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp">

                        <View
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="-10dp"
                            android:layout_marginEnd="-10dp"
                            android:alpha="0.2"
                            android:background="@drawable/bg_route_dot" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:text="🕐"
                                android:textSize="22sp"
                                android:gravity="center"
                                android:background="@drawable/bg_route_dot"
                                android:alpha="0.85" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Schedule"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Departure times"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="3dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/btnSchedule"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="View →"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#FCD34D"
                                android:background="@null"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <!-- DRIVERS CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDrivers"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A1236"
                    android:alpha="0">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp">

                        <View
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="-10dp"
                            android:layout_marginEnd="-10dp"
                            android:alpha="0.15"
                            android:background="@drawable/bg_badge_indigo" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:text="👨‍✈️"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:background="@drawable/bg_badge_indigo"
                                android:alpha="0.9" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Drivers"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contact info"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="3dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/btnDrivers"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="View →"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#A78BFA"
                                android:background="@null"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ═══════════════════════════════════════
                 MANAGE SECTION
                 ═══════════════════════════════════════ -->

            <!-- Divider with label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANAGE TRANSPORT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorIndigo"
                    android:letterSpacing="0.12" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@color/colorDivider" />

            </LinearLayout>

            <!-- ADD NEW BUS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddBus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:text="🚌"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_indigo"
                        android:alpha="0.85" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Register New Bus"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add bus number, route and driver"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAddBus"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Add"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_primary"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ADD NEW ROUTE -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:text="📍"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_emerald"
                        android:alpha="0.9" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New Route"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Define stops and route path"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAddRoute"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Add"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_primary"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ADD NEW SCHEDULE -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAddSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:text="🕐"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/bg_route_dot"
                        android:alpha="0.9" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New Schedule"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set departure and arrival times"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAddSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Add"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_primary"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>