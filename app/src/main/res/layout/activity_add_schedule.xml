<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface">

    <!-- HEADER STRIP -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/bg_hero_gradient"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule a Trip"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set departure and arrival times"
                android:textSize="13sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="🕐"
            android:textSize="38sp"
            android:alpha="0.2" />

    </RelativeLayout>

    <!-- FORM BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorSurfaceCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Select Bus -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT BUS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAmber"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spBus"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:layout_marginBottom="18dp" />

                    <!-- Select Route -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT ROUTE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAmber"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spRoute"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:layout_marginBottom="18dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorDivider"
                        android:layout_marginBottom="18dp" />

                    <!-- Departure Time -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEPARTURE TIME"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAmber"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etDeparture"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="e.g. 7:30 AM"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextSecondary"
                        android:textSize="15sp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="18dp" />

                    <!-- Arrival Time -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ARRIVAL TIME"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAmber"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etArrival"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="e.g. 8:30 AM"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextSecondary"
                        android:textSize="15sp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="6dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CTA Button -->
            <Button
                android:id="@+id/btnAddSchedule"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Confirm Schedule"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>